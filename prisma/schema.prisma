generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A real, session-authenticated user (Auth.js/NextAuth, Google sign-in).
// Every other table has carried a userId from day one, so real multi-user
// support is additive here - no other table's shape changes.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?

  accounts Account[]
  sessions Session[]

  emailConnections EmailConnection[]
  purchases        Purchase[]
  wardrobeItems    WardrobeItem[]
  desiredItems     DesiredItem[]
  budgets          Budget[]

  @@map("users")
}

// Auth.js's own tables (standard PrismaAdapter shape - field names here
// match what @auth/prisma-adapter queries by, verified against its
// installed source). This is deliberately separate from EmailConnection:
// Account/Session are "who is logged into this app" (Auth.js-managed,
// minimal login scope); EmailConnection is "whose Gmail can we read"
// (our own encrypted-at-rest gmail.readonly grant, unchanged).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Required by the PrismaAdapter's type even though this app has no
// email/passwordless provider - never populated with Google-only sign-in.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailConnection {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  // {iv, tag, ciphertext} AES-256-GCM envelope, encrypted at the app level
  // on top of the provider's disk-level encryption. Written starting in
  // implementation Step 3.
  encryptedToken Json     @map("encrypted_token")
  syncCursor     String?  @map("sync_cursor")
  connectedAt    DateTime @default(now()) @map("connected_at")
  status         String   @default("connected")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([userId, provider])
  @@map("email_connections")
}

model Purchase {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  sourceEmailConnectionId String?   @map("source_email_connection_id") @db.Uuid
  merchant                String
  orderDate               DateTime  @map("order_date") @db.Date
  itemName                String    @map("item_name")
  // Null when extraction couldn't confidently isolate this item's own line
  // price (ambiguous multi-item pricing, a subtotal-reconciliation
  // mismatch, or a genuinely missing price) - never a guessed number. Only
  // `active` purchases are guaranteed to have a real price; a null price
  // always implies status = "needs_review".
  price                   Decimal?  @db.Decimal(10, 2)
  category                String
  imageUrl                String?   @map("image_url")
  productLink             String?   @map("product_link")
  sourceEmailId           String?   @map("source_email_id")
  // The retailer's own order number, when identifiable - used to detect
  // that a later shipping/delivery email refers to an order a prior
  // confirmation email already captured, instead of creating a duplicate.
  orderReference          String?   @map("order_reference")
  status                  String    @default("active")
  // Set by confirmReviewPurchase() when a human corrects a needs_review
  // placeholder. extractAndPersistPurchase() checks this before ever
  // deleting/replacing an existing row for an order, so a later, more
  // detailed email can never silently clobber a human correction.
  userEdited              Boolean   @default(false) @map("user_edited")
  // Free-text color for display only (e.g. "Espresso") - never used in
  // redundancy matching. See colorFamily.
  colorName               String?   @map("color_name")
  // One of COLOR_FAMILIES (src/lib/colorFamily.ts). App-validated String,
  // not a Postgres enum, matching this schema's existing convention for
  // status/pauseStatus. Redundancy matching (similarity.ts) uses only this
  // field, never colorName - never populated on Purchase itself by matching,
  // it exists here so seedWardrobeItemFromPurchase can carry it forward.
  colorFamily             String?   @map("color_family")
  // Set to "seed" on rows written by scripts/seedMockWardrobe.ts, so
  // scripts/deleteSeededMockWardrobe.ts can find and remove exactly those
  // rows and nothing else. Null on every real, sync-derived purchase.
  source                  String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailConnection EmailConnection? @relation(fields: [sourceEmailConnectionId], references: [id], onDelete: Cascade)
  wardrobeItems   WardrobeItem[]

  @@map("purchases")
}

model WardrobeItem {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sourcePurchaseId String?   @map("source_purchase_id") @db.Uuid
  itemName         String    @map("item_name")
  imageUrl         String?   @map("image_url")
  category         String?
  // Free-text color for display only (e.g. "Espresso") - never used in
  // redundancy matching. Renamed from primaryColor; see colorFamily.
  colorName        String?   @map("color_name")
  // One of COLOR_FAMILIES (src/lib/colorFamily.ts). Redundancy matching
  // (similarity.ts) uses only this field, never colorName.
  colorFamily      String?   @map("color_family")
  styleTags        String[]  @map("style_tags")
  useCaseTags      String[]  @map("use_case_tags")
  ownedSince       DateTime? @map("owned_since") @db.Date
  status           String    @default("active")
  // Set once tag extraction has run for this item - the explicit signal
  // that extraction is cached, rather than inferring it from whether the
  // tag fields happen to be non-empty (a genuinely tag-less item would
  // otherwise look "not yet tagged" forever and re-run on every read).
  tagsExtractedAt  DateTime? @map("tags_extracted_at")
  // Set to "seed" on rows written by scripts/seedMockWardrobe.ts, so
  // scripts/deleteSeededMockWardrobe.ts can find and remove exactly those
  // rows and nothing else. Null on every real, sync-derived or manually
  // added wardrobe item.
  source           String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePurchase Purchase? @relation(fields: [sourcePurchaseId], references: [id], onDelete: Cascade)
  // Back-relation for the proposed reflectionReplacesWardrobeItem FK on
  // DesiredItem - see that model's comment. Not yet backed by an applied
  // migration.
  reflectingDesiredItems DesiredItem[]

  @@map("wardrobe_items")
}

model DesiredItem {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sourceType      String    @map("source_type")
  rawInput        String?   @map("raw_input")
  itemName        String?   @map("item_name")
  // From the brand list (src/lib/brands/brandList.json) when matched, or
  // free text for an unlisted brand - never validated against the list,
  // since the list is an acceleration aid, not a closed set.
  brand           String?
  // "low" | "medium" | "high" (see FieldConfidence in urlExtractor.ts), or
  // null when itemName is either fully manual or not set at all. Explicit,
  // not inferred from which other fields happen to be populated - the
  // confirm page uses this to show a distinct low-confidence banner
  // instead of presenting a slug-derived guess (URL paste's extraction
  // failure fallback) or a low-confidence search candidate as a fact.
  itemNameConfidence String? @map("item_name_confidence")
  price           Decimal?  @db.Decimal(10, 2)
  imageUrl        String?   @map("image_url")
  category        String?
  // Free-text color for display only (e.g. "Espresso") - never used in
  // redundancy matching. Renamed from primaryColor; see colorFamily.
  colorName       String?   @map("color_name")
  // One of COLOR_FAMILIES (src/lib/colorFamily.ts). Redundancy matching
  // (similarity.ts) uses only this field, never colorName.
  colorFamily     String?   @map("color_family")
  styleTags       String[]  @map("style_tags")
  userConfirmed   Boolean   @default(false) @map("user_confirmed")
  // Set when the user submits the confirm form for this item (whether or
  // not they actually changed a value). ensureDesiredItemTagged() checks
  // this before auto-filling category/color/tags, so it never overwrites
  // what the user explicitly confirmed - including an intentionally blank
  // category.
  userEdited      Boolean   @default(false) @map("user_edited")
  pauseStatus     String    @default("pending_confirmation") @map("pause_status")
  waitUntil       DateTime? @map("wait_until")
  decisionOutcome String?   @map("decision_outcome")
  createdAt       DateTime  @default(now()) @map("created_at")

  // --- Pause screen "a moment to think" reflection (proposed - see
  // prisma/migrations/20260925090000_add_desired_item_reflection/migration.sql).
  // NOT YET APPLIED to either database - do not run `prisma generate`
  // against this until that migration has been run on both the main and
  // test Neon branches, or every DesiredItem query in the app will start
  // requesting columns that don't exist yet. The app code that saves/reads
  // these (src/lib/pauseScreen/reflection.ts) deliberately uses raw SQL
  // instead of the generated client for exactly this reason - it works the
  // moment the migration lands, with no further code or generate step
  // required for that part.
  // Null id + false = "not answered yet" (see reflectionAnsweredAt, the
  // explicit "was this form ever submitted" signal - matches this schema's
  // existing tagsExtractedAt/userEdited idiom rather than inferring intent
  // from which fields happen to be null).
  reflectionReplacesWardrobeItemId String?   @map("reflection_replaces_wardrobe_item_id") @db.Uuid
  // True when the user explicitly picked "Nothing, it's new to me" - kept
  // separate from the id above so "hasn't answered" and "answered nothing"
  // are never conflated.
  reflectionReplacesNothing        Boolean   @default(false) @map("reflection_replaces_nothing")
  // 1-7, "how much do you need it" - app-validated range, not a DB check
  // constraint, matching this schema's existing convention (status,
  // pauseStatus, colorFamily are all app-validated strings/ranges too).
  reflectionNeedScore              Int?      @map("reflection_need_score")
  reflectionReasonFor              String?   @map("reflection_reason_for")
  reflectionReasonAgainst          String?   @map("reflection_reason_against")
  reflectionAnsweredAt             DateTime? @map("reflection_answered_at")

  // --- Considering tab lifecycle timestamps (proposed - see
  // prisma/migrations/20260925100000_add_desired_item_considering_lifecycle/migration.sql).
  // NOT YET APPLIED to either database - same "do not run `prisma generate`
  // until both branches have it" rule as the reflection block above. Also
  // saved/read via raw SQL (src/lib/considering/consideringMeta.ts) for the
  // same reason: every other desired_items query must be unaffected while
  // this is pending.
  // When the current wait (pauseStatus "waiting") started - distinct from
  // createdAt, which is when the item was first flagged, potentially
  // earlier. Set by the wait endpoint; used for the Considering tab's
  // "Paused Sep 24" line.
  pausedAt            DateTime? @map("paused_at")
  // When the item most recently entered pauseStatus "saved_for_later" - set
  // on save and reset on restore-from-let-go. Used for "Saved 34 days ago"
  // and as the anchor for the 60-day auto-move sweep
  // (src/lib/considering/consideringMeta.ts's SAVED_RETENTION_DAYS).
  // Falls back to createdAt (same honest-proxy convention used elsewhere in
  // this schema) for any row saved before this column existed.
  savedAt             DateTime? @map("saved_at")
  // True only when the 60-day sweep moved this item to "let go" on its own
  // - false (the default) for a user-initiated "Let it go"/"Let it go now".
  // Purely a display distinction; decisionOutcome "dropped" already covers
  // both paths identically for counting (src/lib/dashboard/kept.ts's filter
  // needs no change), so this never needs its own separate outcome value.
  letGoAutomatically  Boolean   @default(false) @map("let_go_automatically")
  // When the item most recently became decisionOutcome "dropped" - lets the
  // Considering tab's "this month" kept total stay accurate even though an
  // auto-moved item's createdAt can be up to 60 days earlier than when it
  // was actually let go.
  letGoAt             DateTime? @map("let_go_at")

  // --- Still want it store-visit state (migration
  // 20260926090000_add_desired_item_store_visit).
  // When the user last clicked "Go to [retailer]". Reset on every click.
  wentToStoreAt       DateTime? @map("went_to_store_at")
  // Answer to "Did you buy it?" for that visit: "bought" | "not_bought" |
  // "not_sure", or null while still unanswered. App-validated string, like
  // pauseStatus. Cleared by the next "Go to" click so the prompt re-asks.
  storeVisitAnswer    String?   @map("store_visit_answer")

  user                          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflectionReplacesWardrobeItem WardrobeItem? @relation(fields: [reflectionReplacesWardrobeItemId], references: [id], onDelete: SetNull)

  @@map("desired_items")
}

model Budget {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  month         String
  amount        Decimal @db.Decimal(10, 2)
  categoryScope String  @default("clothing_shoes_accessories") @map("category_scope")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("budgets")
}
